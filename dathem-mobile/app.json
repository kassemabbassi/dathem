{
  "expo": {
    "name": "Dathem",
    "slug": "dathem-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.kassemabbassi.dathem",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Dathem utilise la caméra frontale pour inscrire et reconnaître le visage autorisé."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-notifications",
      "expo-secure-store",
      "react-native-fast-tflite",
      "./plugins/withDathemAgent",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "22b23524-508f-4c0d-ab7f-2cb089458dd5"
      }
    },
    "owner": "kassemabbassi"
  }
}
